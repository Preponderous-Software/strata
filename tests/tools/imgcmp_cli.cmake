# strata-imgcmp's command line: exit codes, --json and --always-diff.
#   cmake -DIMGCMP=<strata-imgcmp> -DGOLDEN=<tests/golden> -DOUT=<scratch dir> -P imgcmp_cli.cmake
cmake_minimum_required(VERSION 3.24)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(morning "${GOLDEN}/l2_csm_morning/linux-llvmpipe.png")
set(noon "${GOLDEN}/l2_csm_noon/linux-llvmpipe.png")
set(small "${GOLDEN}/tex_update_grime/linux-llvmpipe.png")

function(run expect_code out_var)
    execute_process(COMMAND "${IMGCMP}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT code EQUAL expect_code)
        message(FATAL_ERROR "strata-imgcmp ${ARGN}: exit ${code}, expected ${expect_code}\n${stdout}${stderr}")
    endif()
    set(${out_var} "${stdout}" PARENT_SCOPE)
endfunction()

# expect_json(<json> <value> <member> [<index or member>...])
function(expect_json json value)
    string(JSON got GET "${json}" ${ARGN})
    if(NOT got STREQUAL value)
        message(FATAL_ERROR "${ARGN} is '${got}', expected '${value}' in ${json}")
    endif()
endfunction()

# A pass writes no diff without --always-diff, and one with it.
run(0 out "${morning}" "${morning}" --json --diff "${OUT}/same.png")
expect_json("${out}" ON passed)
expect_json("${out}" ON same_size)
expect_json("${out}" 0 pixels_over)
string(JSON diff_type TYPE "${out}" diff)
if(NOT diff_type STREQUAL "NULL")
    message(FATAL_ERROR "diff should be null on a pass without --always-diff: ${out}")
endif()
string(JSON pixels GET "${out}" pixels)
if(NOT pixels EQUAL 230400)
    message(FATAL_ERROR "pixels is ${pixels}, expected 230400")
endif()
if(EXISTS "${OUT}/same.png")
    message(FATAL_ERROR "a passing comparison wrote a diff without --always-diff")
endif()
run(0 out "${morning}" "${morning}" --json --diff "${OUT}/always.png" --always-diff)
expect_json("${out}" "${OUT}/always.png" diff)
if(NOT EXISTS "${OUT}/always.png")
    message(FATAL_ERROR "--always-diff did not write the diff on a pass")
endif()

# A failure: stats, sizes and the diff.
run(1 out "${morning}" "${noon}" --json --diff "${OUT}/fail.png")
expect_json("${out}" OFF passed)
expect_json("${out}" 640 expected_size 0)
expect_json("${out}" 360 actual_size 1)
expect_json("${out}" 4 threshold)
string(JSON over GET "${out}" pixels_over)
string(JSON max GET "${out}" max_delta_e)
if(NOT over GREATER 1000 OR max LESS_EQUAL 4)
    message(FATAL_ERROR "morning vs noon should differ widely: ${out}")
endif()
if(NOT EXISTS "${OUT}/fail.png")
    message(FATAL_ERROR "a failing comparison did not write its diff")
endif()

# Different sizes.
run(1 out "${morning}" "${small}" --json)
expect_json("${out}" OFF same_size)
expect_json("${out}" 320 actual_size 0)

# The text output is unchanged without --json.
run(0 out "${morning}" "${morning}")
if(NOT out MATCHES "^pass: 0 of 230400 pixels over Delta E 4.0")
    message(FATAL_ERROR "unexpected text output: ${out}")
endif()

# Errors: exit 2, and with --json still one object.
run(2 out "${morning}" "${morning}" --always-diff)
run(2 out "${OUT}/missing.png" "${morning}" --json)
expect_json("${out}" OFF passed)
string(JSON error GET "${out}" error)
if(NOT error MATCHES "cannot read")
    message(FATAL_ERROR "unexpected error member: ${error}")
endif()
message(STATUS "strata-imgcmp command line: ok")
