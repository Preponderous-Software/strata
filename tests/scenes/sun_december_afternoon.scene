# ABI 1.6: a December afternoon, 15:00 local time (UTC+1) at 45 degrees
# north, 7.7 degrees east. The low south-western sun, about 11 degrees high,
# throws long shadows north-east across the terrain tile.
size 640 360
camera 52 34 62  -8 2 -12  60 0.3 400
lighting sun 0.50 35  4 2048 150 0.6 1
sun date 2026-12-21 15:00 1 45 7.7
clear 0 0 0 1 sky
include _terrain_hills.scene
