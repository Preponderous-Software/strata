# O1 overlays in a SUN-lit scene: a grid of lines on the floor, a line
# that passes behind a cube (hidden there by depth), points of every kind,
# one partly behind the cube, and text drawn over everything.
size 640 360
camera 0 8 14  0 0 0  55 0.3 200
lighting sun 0.4 35  4 2048 60 0.6 1
clear 0.45 0.65 0.9 1 sky
item cube 0 -0.5 0  20 1 20  0.55 0.6 0.5
item cube 0 1 0  3 3 3  0.8 0.3 0.25
line -8 0.01 -8  -8 0.01 8  0.1 0.1 0.15 0.8
line -8 0.01 -8  8 0.01 -8  0.1 0.1 0.15 0.8
line -6 0.01 -8  -6 0.01 8  0.1 0.1 0.15 0.8
line -8 0.01 -6  8 0.01 -6  0.1 0.1 0.15 0.8
line -4 0.01 -8  -4 0.01 8  0.1 0.1 0.15 0.8
line -8 0.01 -4  8 0.01 -4  0.1 0.1 0.15 0.8
line -2 0.01 -8  -2 0.01 8  0.1 0.1 0.15 0.8
line -8 0.01 -2  8 0.01 -2  0.1 0.1 0.15 0.8
line 0 0.01 -8  0 0.01 8  0.1 0.1 0.15 0.8
line -8 0.01 0  8 0.01 0  0.1 0.1 0.15 0.8
line 2 0.01 -8  2 0.01 8  0.1 0.1 0.15 0.8
line -8 0.01 2  8 0.01 2  0.1 0.1 0.15 0.8
line 4 0.01 -8  4 0.01 8  0.1 0.1 0.15 0.8
line -8 0.01 4  8 0.01 4  0.1 0.1 0.15 0.8
line 6 0.01 -8  6 0.01 8  0.1 0.1 0.15 0.8
line -8 0.01 6  8 0.01 6  0.1 0.1 0.15 0.8
line 8 0.01 -8  8 0.01 8  0.1 0.1 0.15 0.8
line -8 0.01 8  8 0.01 8  0.1 0.1 0.15 0.8
line -6 1 -3  6 1 -3  1 1 0 1
line -6 2 3  6 2 3  0 1 1 1
point 0 1.5 -4  40 0  0.2 0.4 1 1
point -4 3 2  0 1.5  1 1 1 1
point 4 3 2  24 0  1 0.6 0.2 1 soft
point 4 3 2  4 0  1 1 1 1
point 0 0 -80  6 0  1 0 1 1
text 8 8 16  1 1 1 1 shadow : Overlays over SUN lighting
text 8 330 8  0 0 0 0.8 : depth-tested lines and points; text on top
