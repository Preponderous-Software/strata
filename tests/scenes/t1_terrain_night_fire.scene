# T1: the tile at night with a shadow-casting campfire on the valley floor
# and an unshadowed lamp up the slope. The fire lights the valley walls, and
# the standing stones and the tree beside it throw shadows across the terrain.
size 640 360
camera -10 9 28  1 -2 7  60 0.3 400
lighting sun 0.92 35  4 2048 150 0.6 1
clear 0 0 0 1 sky
include _terrain_hills.scene
# the campfire, and the stones and tree around it
item cube 0 -1.8 8  1.2 0.4 0.4  0.35 0.22 0.12
light point 0 -0.9 8  24  1.0 0.55 0.2  6 shadow
item cube 3 0 9  0.8 2.4 0.8  0.55 0.55 0.58
item cube -3 -1.2 10  0.8 2.4 0.8  0.55 0.55 0.58
item sphere 2 -1.2 4  1.4 1.2 1.4  0.55 0.55 0.58
item cylinder 4 0.2 12  0.6 1.5 0.6  0.45 0.30 0.15
item cube 4 2.6 12  2.4 2.4 2.4  0.10 0.45 0.10
light point 14 4 -6  14  1.0 0.85 0.6  3
