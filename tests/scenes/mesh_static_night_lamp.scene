# Static meshes (ABI 1.4): the same meshes at night, lit by a
# shadow-casting street lamp on the road. The blocks and the hall cast cube-map
# shadows away from the lamp onto the terrain and the road ribbon.
size 640 360
camera -6 20 34  2 0 -6  60 0.3 400
lighting sun 0.93 35  4 2048 150 0.6 1
clear 0 0 0 1 sky
include _mesh_town.scene
item cylinder 2 2.4 -3.5  0.3 2.5 0.3  0.3 0.3 0.3
light point 2 5.2 -3.5  30  1.0 0.8 0.5  6 shadow
