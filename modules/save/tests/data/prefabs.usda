#usda 1.0
(
    doc = "Strata save-core test content: a toy game's prefab library."
)

def Scope "Prefabs"
{
    def Xform "Agent" (
        variants = {
            string mood = "calm"
        }
        prepend variantSets = "mood"
    )
    {
        double toy:stats:speed = 1
        variantSet "mood" = {
            "angry" {
                double toy:stats:speed = 2
            }
            "calm" {
                double toy:stats:speed = 1
            }
        }
    }

    def Xform "Prop"
    {
        double toy:stats:weight = 3
    }
}
